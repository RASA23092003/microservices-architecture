pipeline{
    agent any
    tools{
        maven 'maven_built_tool'
    }
    environment{
        DOCKER_IMAGE='epharmacy-customer'
        CONTAINER_NAME='customer-container'
    }
    stages{
        stage('git clone'){
            steps{
                git branch: 'epharmacy', credentialsId: 'github_credential', url: 'https://github.com/RASA23092003/microservices-architecture.git'
            }
        }
        stage('list files'){
            steps{
                bat 'dir'
            }
        }
        stage('junit test'){
            steps{
                dir('epharmacy-ms-server-main/Epharmacy_CustomerMS'){
                    bat 'mvn test'
                }
            }
        }
        stage('Maven Build phase'){
            steps{
                dir('epharmacy-ms-server-main/Epharmacy_CustomerMS'){
                    bat 'mvn clean package -DskipTests'
                }
            }
        }
        stage('List Files') {
            steps {
                dir('epharmacy-ms-server-main/Epharmacy_CustomerMS'){
                bat 'dir'
                }
            }
        }
        
        stage('Docker Image creation phase'){
            steps{
                dir('epharmacy-ms-server-main/Epharmacy_CustomerMS'){
                    bat 'docker build -t %DOCKER_IMAGE%:%BUILD_NUMBER% .'
                }
            }
        }
         stage('Delete old Docker container'){
            steps{
                dir('epharmacy-ms-server-main/Epharmacy_CustomerMS'){
                    bat 'docker rm -f %CONTAINER_NAME% || echo not exists'
                }
            }
        }
        stage('Docker container run phase'){
            steps{
                dir('epharmacy-ms-server-main/Epharmacy_CustomerMS'){
                    bat 'docker run -d -p 8081:6100 --name %CONTAINER_NAME% %DOCKER_IMAGE%:%BUILD_NUMBER%'
                }
            }
        }
    }
}
